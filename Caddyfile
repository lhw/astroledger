# ScolyMarket Caddyfile — production reverse proxy
#
# Replace "scolymarket.example.com" with your actual domain.
# Caddy automatically provisions HTTPS via Let's Encrypt.

scolymarket.example.com {
    header {
        Strict-Transport-Security "max-age=31536000; includeSubDomains; preload"
        X-Content-Type-Options "nosniff"
        Referrer-Policy "strict-origin-when-cross-origin"
        X-Frame-Options "DENY"
        # script-src and connect-src include stats.scolymarket.example.com for GoatCounter
        Content-Security-Policy "default-src 'self'; base-uri 'self'; frame-ancestors 'none'; form-action 'self'; object-src 'none'; img-src 'self' data: https:; style-src 'self' 'unsafe-inline'; script-src 'self' 'unsafe-inline' https://stats.scolymarket.example.com; connect-src 'self' https://stats.scolymarket.example.com"
    }

    # Backend API and auth endpoints
    reverse_proxy /api/* backend:8080
    reverse_proxy /auth/* backend:8080

    # Everything else goes to the SvelteKit frontend
    reverse_proxy frontend:3000
}

# GoatCounter analytics dashboard — cookie-free, privacy-first
# Access the admin UI at https://stats.scolymarket.example.com
# Run `task gc:init` once after first deploy to create the admin account.
stats.scolymarket.example.com {
    reverse_proxy goatcounter:8081
}
