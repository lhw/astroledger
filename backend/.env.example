# ScolyMarket Backend — Environment Variables
# Copy this to .env and fill in real values. Never commit .env to git.

# ── Server ─────────────────────────────────────────────────────────────────
PORT=8080
ENVIRONMENT=development
COOKIE_SECURE=false
# Comma-separated allowed origins for CORS. In production, set to your frontend URL.
CORS_ALLOWED_ORIGINS=http://localhost:5173
FRONTEND_URL=http://localhost:5173

# ── Database ───────────────────────────────────────────────────────────────
DB_PATH=./scolymarket.db

# ── Session ────────────────────────────────────────────────────────────────
# Must be at least 32 bytes of random data. Generate with: openssl rand -base64 32
SESSION_SECRET=replace-with-a-random-secret-at-least-32-chars-long

# ── SCID / OIDC ────────────────────────────────────────────────────────────
# Obtain these by registering ScolyMarket as a confidential OIDC client on scid.my
SCID_CLIENT_ID=your-client-id-from-scid.my
SCID_CLIENT_SECRET=your-client-secret-from-scid.my
SCID_ISSUER=https://auth.scid.my
# Must match the redirect URI registered on scid.my exactly.
SCID_REDIRECT_URL=http://localhost:8080/auth/callback
