# AstroLedger — Production Environment Variables
# Copy this file to .env and fill in all values. Never commit .env to git.
#
# For local development use backend/.env (loaded automatically by "task dev").
# This file is consumed by docker-compose.yml via env_file: .env.

# ── Public URL ─────────────────────────────────────────────────────────────
# The canonical external HTTPS URL. Must match the hostname in Caddyfile.
# Required by SvelteKit adapter-node CSRF protection (ORIGIN) and by the
# SCID redirect URI you registered on scid.my.
#   Generate:  echo "https://yourdomain.com"
ORIGIN=https://astroledger.example.com

# ── CORS ───────────────────────────────────────────────────────────────────
# Go backend only accepts cross-origin requests from this URL.
# In production this is the same as ORIGIN.
CORS_ALLOWED_ORIGINS=https://astroledger.example.com

# ── Session ────────────────────────────────────────────────────────────────
# Random secret used to sign session cookies. Minimum 32 characters.
#   Generate:  openssl rand -base64 32
SESSION_SECRET=replace-with-at-least-32-chars-of-random-data

# ── SCID / OIDC ────────────────────────────────────────────────────────────
# Confidential OIDC client registered at scid.my.
# Redirect URI to register: ${ORIGIN}/auth/callback
SCID_ISSUER=https://auth.scid.my
SCID_CLIENT_ID=your-client-id-from-scid.my
SCID_CLIENT_SECRET=your-client-secret-from-scid.my
SCID_REDIRECT_URL=https://astroledger.example.com/auth/callback

# ── Logging ────────────────────────────────────────────────────────────────
LOG_LEVEL=info

# ── Analytics (GoatCounter) ────────────────────────────────────────────────
# Cookie-free, self-hosted analytics served at stats.<your-domain>.
# Run once after first deploy to create the admin account: task gc:init
#
# API key: GoatCounter dashboard → Settings → API keys → Create.
# Used by hooks.server.ts (server-side hit recording — uBlock cannot block this)
# and by the admin analytics proxy endpoint.
GOATCOUNTER_API_KEY=

# GoatCounter SQLite database path inside the container volume.
# Switch to PostgreSQL if preferred: GC_DB=postgres://user:pass@host:5432/gc
GC_DB=sqlite+/data/goatcounter.db

# ── AI Comment Moderation (optional) ──────────────────────────────────────
# OpenAI API key used for automated comment abuse detection.
# Leave empty to disable — all comments will pass moderation automatically.
OPENAI_API_KEY=
