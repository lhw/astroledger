# ScolyMarket — Production Environment Variables
# Copy this to .env and fill in real values. Never commit .env to git.
#
# This file is used by docker-compose. For local development, see backend/.env.example.

# ── Public URL ─────────────────────────────────────────────────────────────
# The external HTTPS URL where ScolyMarket is served. Must match your Caddyfile.
# Used by SvelteKit (ORIGIN) and by SCID callback URL.
ORIGIN=https://scolymarket.example.com

# ── CORS ───────────────────────────────────────────────────────────────────
# Backend will only accept cross-origin requests from this URL.
CORS_ALLOWED_ORIGINS=https://scolymarket.example.com

# ── Session ────────────────────────────────────────────────────────────────
# Must be at least 32 bytes of random data. Generate with:
#   openssl rand -base64 32
SESSION_SECRET=replace-with-at-least-32-chars-of-random-data

# ── SCID / OIDC ────────────────────────────────────────────────────────────
# Register ScolyMarket as a confidential OIDC client on scid.my.
# Redirect URI to register: https://scolymarket.example.com/auth/callback
SCID_ISSUER=https://scid.my
SCID_CLIENT_ID=your-client-id-from-scid.my
SCID_CLIENT_SECRET=your-client-secret-from-scid.my
SCID_REDIRECT_URL=https://scolymarket.example.com/auth/callback

# ── Logging ────────────────────────────────────────────────────────────────
LOG_LEVEL=info

# ── Analytics ──────────────────────────────────────────────────────────────
# GoatCounter: cookie-free, self-hosted analytics. No cookie banner needed.
# Set to the public URL of your GoatCounter instance (stats subdomain).
# Leave empty to disable analytics entirely.
# After deploying, run once: task gc:init
GOATCOUNTER_URL=https://stats.scolymarket.example.com

# API key for the analytics admin proxy. Generate in GoatCounter: Settings → API Keys.
GOATCOUNTER_API_KEY=

# Internal URL used by the Go backend to reach GoatCounter (Docker service name).
# Defaults to http://goatcounter:8081 — only change if you rename the service.
# GOATCOUNTER_URL=http://goatcounter:8081

# GoatCounter database. Defaults to a separate SQLite file inside the container.
# Override with a PostgreSQL DB if desired:
# GC_DB=postgres://user:pass@db:5432/goatcounter
